# ── API Server (set these on Render) ──────────────────────────────────────────
# PostgreSQL connection string from Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign JWT tokens — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Set automatically by Render — do not change
PORT=10000
NODE_ENV=production

# ── Frontend (set these on Vercel) ────────────────────────────────────────────
# Full URL of your Render API service (no trailing slash)
VITE_API_URL=https://expense-tracker-api.onrender.com
