{
  "installCommand": "npm install -g pnpm@9 && pnpm install --no-frozen-lockfile",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/expense-tracker run build",
  "outputDirectory": "artifacts/expense-tracker/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
