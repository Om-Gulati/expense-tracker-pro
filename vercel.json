{
  "installCommand": "npm install -g pnpm@latest && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run typecheck:libs && BASE_PATH=/ pnpm --filter @workspace/expense-tracker run build",
  "outputDirectory": "artifacts/expense-tracker/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
